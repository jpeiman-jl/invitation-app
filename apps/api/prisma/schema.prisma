generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  GOOGLE
}

enum InvitationStatus {
  CREATED
  SENT
  OPENED
  RESPONDED
  REVOKED
}

enum RsvpStatus {
  ATTENDING
  DECLINED
  MAYBE
}

enum TableType {
  ROUND
  RECTANGULAR
  SQUARE
  BANQUET
  HEAD
  SWEETHEART
  COCKTAIL
  CUSTOM
}

enum TemplateType {
  DEFAULT
  CUSTOM
}

enum DesignGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LLMProvider {
  ANTHROPIC
  OPENAI
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum EmailKind {
  INVITATION
  REMINDER
  RSVP_CONFIRMATION
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(320)
  passwordHash  String?        @map("password_hash")
  name          String         @db.VarChar(160)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  identities    AuthIdentity[]
  sessions      AuthSession[]
  events        Event[]
  templates     Template[]
  payments      Payment[]

  @@map("users")
}

model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Event {
  id                         String             @id @default(uuid()) @db.Uuid
  ownerId                    String             @map("owner_id") @db.Uuid
  title                      String             @db.VarChar(200)
  hostNames                  String[]           @default([]) @map("host_names")
  startsAt                   DateTime           @map("starts_at") @db.Timestamptz(3)
  timeZone                   String             @map("time_zone") @db.VarChar(64)
  occasionTypes              Json               @default("[\"wedding\"]") @map("occasion_types")
  templateKey                String             @default("wedding") @map("template_key") @db.VarChar(60)
  venue                      String?            @db.VarChar(200)
  address                    String?            @db.VarChar(500)
  mapUrl                     String?            @map("map_url") @db.VarChar(2048)
  description                String?            @db.Text
  dressCode                  String?            @map("dress_code") @db.VarChar(200)
  programItems               Json               @default("[]") @map("program_items")
  rsvpDeadline               DateTime?          @map("rsvp_deadline") @db.Timestamptz(3)
  coverImageUrl              String?            @map("cover_image_url") @db.VarChar(2048)
  publicSlug                 String?            @unique @map("public_slug") @db.VarChar(100)
  publicGuestLookupEnabled   Boolean            @default(false) @map("public_guest_lookup_enabled")
  seatingPublishedAt         DateTime?          @map("seating_published_at") @db.Timestamptz(3)
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guests                     Guest[]
  tables                     EventTable[]
  templateId                 String?            @map("template_id") @db.Uuid
  template                   Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  entitlement                EventEntitlement?
  designGenerations          DesignGeneration[]
  payments                   Payment[]
  emailLogs                  EmailLog[]

  @@index([ownerId, startsAt])
  @@map("events")
}

model Guest {
  id                    String           @id @default(uuid()) @db.Uuid
  eventId               String           @map("event_id") @db.Uuid
  name                  String           @db.VarChar(160)
  email                 String?          @db.VarChar(320)
  phone                 String?          @db.VarChar(40)
  household             String?          @db.VarChar(160)
  maxPartySize          Int              @default(1) @map("max_party_size")
  notes                 String?          @db.Text
  dietaryRestrictions   String?          @map("dietary_restrictions") @db.Text
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  event                 Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation            Invitation?
  rsvp                  Rsvp?
  seatAssignments       SeatAssignment[]

  @@index([eventId, name])
  @@index([eventId, email])
  @@map("guests")
}

model Invitation {
  id            String           @id @default(uuid()) @db.Uuid
  guestId       String           @unique @map("guest_id") @db.Uuid
  tokenHash     String           @unique @map("token_hash") @db.VarChar(128)
  tokenCiphertext String         @map("token_ciphertext") @db.Text
  status        InvitationStatus @default(CREATED)
  sentAt        DateTime?        @map("sent_at") @db.Timestamptz(3)
  remindedAt    DateTime?        @map("reminded_at") @db.Timestamptz(3)
  openedAt      DateTime?        @map("opened_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  guest         Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  rsvp          Rsvp?
  emailLogs     EmailLog[]

  @@map("invitations")
}

model Rsvp {
  id              String     @id @default(uuid()) @db.Uuid
  guestId         String     @unique @map("guest_id") @db.Uuid
  invitationId    String     @unique @map("invitation_id") @db.Uuid
  status          RsvpStatus
  partySize       Int        @map("party_size")
  companionNames  String[]   @default([]) @map("companion_names")
  dietary         String?    @db.Text
  message         String?    @db.Text
  respondedAt     DateTime   @map("responded_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  guest           Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@map("rsvps")
}

model EventTable {
  id            String           @id @default(uuid()) @db.Uuid
  eventId       String           @map("event_id") @db.Uuid
  label         String           @db.VarChar(100)
  type          TableType
  customType    String?          @map("custom_type") @db.VarChar(100)
  capacity      Int
  positionX     Float            @default(0) @map("position_x")
  positionY     Float            @default(0) @map("position_y")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments   SeatAssignment[]

  @@unique([eventId, label])
  @@index([eventId])
  @@map("event_tables")
}

model SeatAssignment {
  id                String     @id @default(uuid()) @db.Uuid
  tableId           String     @map("table_id") @db.Uuid
  seatNumber        Int         @map("seat_number")
  guestId           String      @map("guest_id") @db.Uuid
  attendeeName      String      @map("attendee_name") @db.VarChar(160)
  isPrimaryGuest    Boolean     @default(false) @map("is_primary_guest")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  table             EventTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest             Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([tableId, seatNumber])
  @@index([guestId])
  @@map("seat_assignments")
}

model Template {
  id          String       @id @default(uuid()) @db.Uuid
  type        TemplateType
  name        String       @db.VarChar(120)
  category    String       @db.VarChar(80)
  version     Int          @default(1)
  schemaJson  Json         @map("schema_json")
  isActive    Boolean      @default(true) @map("is_active")
  ownerId     String?      @map("owner_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events      Event[]

  @@index([type, category, isActive])
  @@index([ownerId])
  @@map("templates")
}

model DesignGeneration {
  id            String                 @id @default(uuid()) @db.Uuid
  eventId       String                 @map("event_id") @db.Uuid
  version       Int
  prompt        String                 @db.Text
  followUp      String?                @map("follow_up") @db.Text
  provider      LLMProvider
  status        DesignGenerationStatus @default(PENDING)
  resultJson    Json?                  @map("result_json")
  errorCode     String?                @map("error_code") @db.VarChar(100)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?              @map("completed_at") @db.Timestamptz(3)
  event         Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, version])
  @@index([eventId, createdAt])
  @@map("design_generations")
}

model Plan {
  id                    String             @id @default(uuid()) @db.Uuid
  key                   String             @unique @db.VarChar(80)
  name                  String             @db.VarChar(120)
  priceCents            Int                @map("price_cents")
  currency              String             @default("usd") @db.VarChar(3)
  guestLimit            Int                @map("guest_limit")
  activeEventLimit      Int                @map("active_event_limit")
  maxDesignGenerations  Int                @default(0) @map("max_design_generations")
  features              Json               @default("{}")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  entitlements          EventEntitlement[]
  payments              Payment[]

  @@map("plans")
}

model EventEntitlement {
  id                    String             @id @default(uuid()) @db.Uuid
  eventId               String             @unique @map("event_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  paymentId             String?            @unique @map("payment_id") @db.Uuid
  status                EntitlementStatus  @default(ACTIVE)
  designGenerationsUsed Int                @default(0) @map("design_generations_used")
  grantedAt             DateTime           @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt             DateTime?          @map("expires_at") @db.Timestamptz(3)
  event                 Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan                  Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment               Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@map("event_entitlements")
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  eventId                 String        @map("event_id") @db.Uuid
  planId                  String        @map("plan_id") @db.Uuid
  status                  PaymentStatus @default(PENDING)
  amountCents             Int           @map("amount_cents")
  currency                String        @default("usd") @db.VarChar(3)
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  stripeCheckoutUrl       String?       @map("stripe_checkout_url") @db.VarChar(2048)
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(3)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  event                   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  plan                    Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlement             EventEntitlement?

  @@index([userId, createdAt])
  @@index([eventId, status])
  @@map("payments")
}

model EmailLog {
  id             String      @id @default(uuid()) @db.Uuid
  eventId        String      @map("event_id") @db.Uuid
  invitationId   String?     @map("invitation_id") @db.Uuid
  kind           EmailKind
  status         EmailStatus @default(QUEUED)
  recipient      String      @db.VarChar(320)
  provider       String?     @db.VarChar(80)
  providerId     String?     @map("provider_id") @db.VarChar(255)
  errorCode      String?     @map("error_code") @db.VarChar(100)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime?   @map("sent_at") @db.Timestamptz(3)
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation     Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([eventId, kind, status])
  @@index([invitationId, createdAt])
  @@map("email_logs")
}

model StripeWebhookEvent {
  id          String   @id @map("id") @db.VarChar(255)
  type        String   @db.VarChar(120)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_webhook_events")
}
